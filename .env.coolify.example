# Web runs as a production Next.js server.
# API runs production auth. For local/private smoke tests only, switch both
# AUTH_MODE and NEXT_PUBLIC_AUTH_MODE back to dev behind the gateway.
API_NODE_ENV=production
WEB_NODE_ENV=production
# Used by docker-compose.coolify.images.yml to pull prebuilt GHCR images.
IMAGE_TAG=master

AUTH_MODE=entra
NEXT_PUBLIC_AUTH_MODE=entra
ENTRA_TENANT_ID=replace-with-tenant-id
ENTRA_CLIENT_ID=replace-with-api-client-id
ENTRA_AUDIENCE=
NEXT_PUBLIC_ENTRA_TENANT_ID=replace-with-tenant-id
NEXT_PUBLIC_ENTRA_CLIENT_ID=replace-with-spa-client-id
NEXT_PUBLIC_ENTRA_SCOPES=api://replace-with-api-client-id/access_as_user
NEXT_PUBLIC_ENTRA_REDIRECT_URI=http://127.0.0.1:8080
NEXT_PUBLIC_ENTRA_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:8080
API_INTERNAL_AUTH_TOKEN=change-me-long-random-internal-token
INTERNAL_USER_EMAIL=admin@immologik.local
INTERNAL_USER_NAME=Immologik Web
INTERNAL_TENANT_SLUG=default

POSTGRES_DB=immologik
POSTGRES_USER=immologik
POSTGRES_PASSWORD=change-me-long-random-password
# Optional override when POSTGRES_PASSWORD contains URL-sensitive characters
# such as /, @, :, #, ?, %, or spaces. URL-encode the password here.
# Example: password abc/def becomes abc%2Fdef.
# Leave DATABASE_URL unset when the password is plain alphanumeric, so the
# compose file derives it from POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB.
# DATABASE_URL=postgresql://immologik:change-me-long-random-password@postgres:5432/immologik?schema=public

MINIO_ROOT_USER=immologik-minio
MINIO_ROOT_PASSWORD=change-me-long-random-minio-password
S3_REGION=us-east-1
S3_BUCKET=immologik-local

# Safe default without domain: expose one Basic-Auth gateway only.
# For direct IP testing, set GATEWAY_PUBLIC_BIND=178.104.65.232:8080.
GATEWAY_PUBLIC_BIND=127.0.0.1:8080
BASIC_AUTH_USER=immologik
# Generate with:
# docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# In .env files, dollar signs in bcrypt hashes may need escaping as $$.
BASIC_AUTH_HASH=replace-with-caddy-bcrypt-hash

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080/api/v1
DOCUMENTS_PUBLIC_API_BASE_URL=http://127.0.0.1:8080/api/v1
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080

TOKEN_RATE_LIMIT=20
TOKEN_RATE_WINDOW_MS=60000
GLOBAL_RATE_LIMIT=600
GLOBAL_RATE_WINDOW_MS=60000

# Optional scheduled cloud backup, e.g. daily at 02:30 UTC.
# Requires BACKUP_REMOTE and an rclone remote configured in the backup container.
# BACKUP_REMOTE=onedrive:ImmoLogik Backups
# BACKUP_KEEP_DAYS=7
# BACKUP_CRON="30 2 * * *"
