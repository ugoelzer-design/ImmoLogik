{
  "name": "immologik",
  "private": true,
  "scripts": {
    "predev": "kill-port 3001 4000",
    "dev": "concurrently -n api,web \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "predev:api": "kill-port 4000",
    "dev:api": "dotenv -e .env -- pnpm --dir apps/api start:dev",
    "predev:web": "kill-port 3001",
    "dev:web": "pnpm --dir apps/web run dev",
    "build": "pnpm --dir apps/api build && pnpm --dir apps/web build",
    "lint": "pnpm --dir apps/api lint && pnpm --dir apps/web lint",
    "test": "pnpm run test:api && pnpm run test:web",
    "test:api": "pnpm --dir apps/api run test",
    "test:e2e": "pnpm --dir apps/api run test:e2e",
    "test:web": "pnpm --dir apps/web run test",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "dotenv-cli": "^11.0.0",
    "kill-port": "^2.0.1"
  }
}
