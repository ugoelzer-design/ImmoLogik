generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  displayName String
  role        InternalRole @default(EMPLOYEE)
  isActive    Boolean      @default(true)
  tenantId    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model PropertyObject {
  id                String   @id @default(cuid())
  displayId         String   @unique
  name              String
  address           String
  type              String
  status            String
  units             Int      @default(1)
  occupancy         String   @default("0%")
  monthlyTargetRent String   @default("0 â‚¬")
  note              String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("objects")
}

model Document {
  id          String   @id @default(cuid())
  title       String
  fileName    String
  mimeType    String
  size        Int
  storageKey  String   @unique
  objectId    String?
  objectName  String?
  category    String   @default("Sonstiges")
  status      String   @default("Vorhanden")
  uploadedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("documents")
}

model RentUnit {
  id             String   @id @default(cuid())
  objectId       String
  unitLabel      String
  tenant         String
  sollMiete      Float
  istMiete       Float    @default(0)
  zahlungsStatus String   @default("Offen")
  faelligAm      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("rent_units")
}

model Mieter {
  id         String   @id @default(cuid())
  fullName   String
  objectName String
  unit       String
  email      String
  phone      String
  status     String   @default("Aktiv")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("mieter")
}

model Vertrag {
  id         String   @id @default(cuid())
  title      String
  objectName String
  tenantName String
  startDate  String
  endDate    String
  status     String   @default("Aktiv")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("vertraege")
}

enum InternalRole {
  ADMIN
  EMPLOYEE
}
