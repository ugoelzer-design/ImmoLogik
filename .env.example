NODE_ENV=development

APP_NAME=ImmoLogik

WEB_PORT=3001
API_PORT=4000
WEB_ORIGIN=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3001
NEXT_PUBLIC_APP_NAME=ImmoLogik
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

POSTGRES_DB=immologik
POSTGRES_USER=immologik
POSTGRES_PASSWORD=immologik
POSTGRES_PORT=5432
DATABASE_URL=postgresql://immologik:immologik@localhost:5432/immologik?schema=public

MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
