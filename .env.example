NODE_ENV=development

APP_NAME=ImmoLogik

WEB_PORT=3001
API_PORT=4000
WEB_ORIGIN=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3001
NEXT_PUBLIC_APP_NAME=ImmoLogik
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

POSTGRES_DB=immologik
POSTGRES_USER=immologik
POSTGRES_PASSWORD=immologik
POSTGRES_PORT=5432
DATABASE_URL=postgresql://immologik:immologik@localhost:5432/immologik?schema=public

MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=immologik-local
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

DOCUMENTS_STORAGE_ROOT=
DOCUMENTS_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

AUTH_MODE=dev
NEXT_PUBLIC_AUTH_MODE=dev
API_INTERNAL_AUTH_TOKEN=
INTERNAL_USER_EMAIL=admin@immologik.local
INTERNAL_USER_NAME=Immologik Web
INTERNAL_TENANT_SLUG=default
API_DOCS_ENABLED=false
DEV_AUTH_USER_EMAIL=admin@immologik.local
DEV_AUTH_USER_NAME=Admin Lokal

ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_AUDIENCE=
ENTRA_CLIENT_SECRET=
NEXT_PUBLIC_ENTRA_TENANT_ID=
NEXT_PUBLIC_ENTRA_CLIENT_ID=
NEXT_PUBLIC_ENTRA_SCOPES=
NEXT_PUBLIC_ENTRA_REDIRECT_URI=http://localhost:3001
NEXT_PUBLIC_ENTRA_POST_LOGOUT_REDIRECT_URI=http://localhost:3001
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

BACKUP_REMOTE=
BACKUP_KEEP_DAYS=7
